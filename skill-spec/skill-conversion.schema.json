{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiniMuv knowledge-only Skill conversion v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "capability_snapshot_id", "source_snapshot_id", "status", "package", "report"],
  "properties": {
    "schema_version": {"const": "minimuv-skill-conversion/v1"},
    "request_id": {"$ref": "#/$defs/id"},
    "capability_snapshot_id": {"$ref": "#/$defs/id"},
    "source_snapshot_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["draft", "blocked"]},
    "package": {"oneOf": [{"$ref": "#/$defs/package"}, {"type": "null"}]},
    "report": {"$ref": "#/$defs/report"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "draft"}}},
      "then": {
        "properties": {
          "package": {"$ref": "#/$defs/package"},
          "report": {"properties": {"blockers": {"maxItems": 0}}}
        }
      },
      "else": {
        "properties": {
          "package": {"type": "null"},
          "report": {"properties": {"blockers": {"minItems": 1}}}
        }
      }
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 6000, "pattern": "\\S", "not": {"pattern": "\\u0000"}},
    "shortText": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 1024}]},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$", "not": {"pattern": "\\s"}},
    "modelId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "not": {"anyOf": [{"const": "*"}, {"pattern": "\\u0000"}]}},
    "task": {"enum": ["prompt-enhancement", "storyboard"]},
    "mode": {"enum": ["video", "mv", "image", "music", "long-video"]},
    "taskMode": {
      "if": {"properties": {"task": {"const": "storyboard"}}},
      "then": {"properties": {"mode": {"const": "long-video"}}},
      "else": {"properties": {"mode": {"enum": ["video", "mv", "image", "music"]}}}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "excerpt"],
      "properties": {
        "file_id": {"$ref": "#/$defs/id"},
        "excerpt": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 800}]}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "mode", "behavior", "output_contract", "target_models", "instructions", "evidence"],
      "properties": {
        "task": {"$ref": "#/$defs/task"},
        "mode": {"$ref": "#/$defs/mode"},
        "behavior": {"enum": ["faithful", "story-adaptation"]},
        "output_contract": {"enum": ["enhancement-json/v1", "storyboard-json/v1"]},
        "target_models": {
          "oneOf": [
            {"const": ["*"]},
            {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/modelId"}}
          ]
        },
        "instructions": {"$ref": "#/$defs/text"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {"$ref": "#/$defs/taskMode"},
        {
          "if": {"properties": {"task": {"const": "storyboard"}}},
          "then": {"properties": {"behavior": {"const": "story-adaptation"}, "output_contract": {"const": "storyboard-json/v1"}}},
          "else": {"properties": {"behavior": {"const": "faithful"}, "output_contract": {"const": "enhancement-json/v1"}}}
        }
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "name", "version", "description", "kind", "bindings"],
      "properties": {
        "format": {"const": "minimuv-skill/v1"},
        "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "\\s"}},
        "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "not": {"pattern": "\\s"}},
        "description": {"$ref": "#/$defs/shortText"},
        "kind": {"const": "knowledge-only"},
        "bindings": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "evidence"],
      "properties": {
        "code": {"enum": ["execution", "external-service", "unsupported-capability", "instruction-injection", "output-conflict"]},
        "reason": {"$ref": "#/$defs/shortText"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason"],
      "properties": {
        "code": {"enum": ["license-unknown", "license-restricted", "invalid-input", "insufficient-material", "not-portable", "unsupported-binding"]},
        "reason": {"$ref": "#/$defs/shortText"}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "removed", "warnings", "blockers"],
      "properties": {
        "summary": {"$ref": "#/$defs/shortText"},
        "removed": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/removal"}},
        "warnings": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}},
        "blockers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/blocker"}}
      }
    },
    "allowedBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "mode", "model_ids", "generic_allowed", "constraints"],
      "properties": {
        "task": {"$ref": "#/$defs/task"},
        "mode": {"$ref": "#/$defs/mode"},
        "model_ids": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/modelId"}},
        "generic_allowed": {"type": "boolean"},
        "constraints": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/shortText"}}
      },
      "allOf": [{"$ref": "#/$defs/taskMode"}]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "trusted_context", "source_material"],
      "properties": {
        "schema_version": {"const": "minimuv-skill-request/v1"},
        "trusted_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_id", "capability_snapshot_id", "source_snapshot_id", "license_status", "license_obligations", "allowed_bindings", "max_instruction_chars"],
          "properties": {
            "request_id": {"$ref": "#/$defs/id"},
            "capability_snapshot_id": {"$ref": "#/$defs/id"},
            "source_snapshot_id": {"$ref": "#/$defs/id"},
            "license_status": {"enum": ["verified", "unknown", "restricted"]},
            "license_obligations": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/shortText"}},
            "allowed_bindings": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/allowedBinding"}},
            "max_instruction_chars": {"type": "integer", "minimum": 1, "maximum": 6000}
          }
        },
        "source_material": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files"],
          "properties": {
            "files": {
              "type": "array", "minItems": 1, "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "path", "content"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"},
                  "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*$", "not": {"anyOf": [{"pattern": "(^|/)\\.{1,2}(/|$)"}, {"pattern": "\\s"}]}},
                  "content": {"type": "string", "minLength": 1, "maxLength": 96000, "not": {"pattern": "\\u0000"}}
                }
              }
            }
          }
        }
      }
    },
    "enhancementResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keywords", "optimized_prompt"],
      "properties": {
        "keywords": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 120}]}},
        "optimized_prompt": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 4000}]}
      }
    },
    "storyboardResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shots"],
      "properties": {
        "shots": {
          "type": "array", "minItems": 1, "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "prompt", "duration", "music_prompt"],
            "properties": {
              "title": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 120}]},
              "prompt": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 4000}]},
              "duration": {"type": "number", "minimum": 1, "maximum": 20, "multipleOf": 1},
              "music_prompt": {"allOf": [{"$ref": "#/$defs/text"}, {"maxLength": 4000}]}
            }
          }
        }
      }
    }
  }
}
